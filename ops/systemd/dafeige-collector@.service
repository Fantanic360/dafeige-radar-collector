# /etc/systemd/system/dafeige-collector@.service
# 用 dafeige-collector@<repo-path-escaped>.service 调用；WorkingDirectory 指向仓库。
[Unit]
Description=Dafeige radar collector round
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%f
# run-scheduled 负责把「原计划时刻」传给采集器；不要直接跑 src/cli.mjs run
ExecStart=/usr/bin/env node ops/run-scheduled.mjs
Environment=RADAR_LOG_LEVEL=info
TimeoutStartSec=1800
Nice=10
